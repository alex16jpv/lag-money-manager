PORT=3000
DB_TYPE=MONGO
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret
# Optional separate secret for refresh tokens (falls back to JWT_SECRET);
# lets you rotate the access secret without killing every session.
# REFRESH_SECRET=
# Short-lived access token; renew with the refresh token at POST /auth/refresh.
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Global request rate limit per 15 min window. Keyed by user once
# authenticated, by IP only for the public routes.
RATE_LIMIT_MAX=1000
# Failed logins/registers per recognized device, or per email and IP (per 15 min window).
AUTH_RATE_LIMIT_MAX=10
# Failed logins/registers per email from unrecognized devices, across all IPs (per hour).
AUTH_EMAIL_RATE_LIMIT_MAX=50
# Per-IP limit for /auth/login and /auth/register: higher, because a carrier NAT
# puts thousands of unrelated users behind one address.
AUTH_IP_RATE_LIMIT_MAX=60
# Refresh gets its own, higher threshold (legitimate ~15min cadence per device)
REFRESH_RATE_LIMIT_MAX=60

# Shared secret expected in the `x-api-secret` header (gateway/front-door check).
# ALL-OR-NOTHING: once set, EVERY request must send the header or gets 403 --
# including /, /health/db and /auth. Leave it commented out in local dev.
# API_SECRET=

# Email. Nothing is sent until EMAIL_PROVIDERS names a provider (docs/modules/email.md).
# Locally, Mailpit catches everything: docker compose up -d mailpit, then http://localhost:8025
EMAIL_PROVIDERS=mailpit
# Where the links in an email point: the front in development.
APP_URL=http://localhost:3001
# EMAIL_SENDING_ENABLED=true
# Spending caps per UTC day and month (9000 = 0.90 USD at SES's price), and the reset's share.
# EMAIL_DAILY_CAP=300
# EMAIL_MONTHLY_CAP=9000
# EMAIL_RESET_SHARE_PERCENT=30
# EMAIL_OTHER_SHARE_PERCENT=20
# Production only: EMAIL_PROVIDERS=ses, and optionally
# EMAIL_SES_CONFIGURATION_SET=
# The SNS topic SES reports bounces and complaints to; the webhook refuses every other topic.
# EMAIL_SES_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:<account>:<topic>

# MongoDB. Local dev uses the single-node replica set from docker-compose:
#   directConnection=true is required to talk to a one-node replica set.
MONGO_URI=mongodb://localhost:27017/lag_money?replicaSet=rs0&directConnection=true
# Production (MongoDB Atlas) example:
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lag?retryWrites=true&w=majority
