PORT=3000
DB_TYPE=MONGO
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Global request rate limit (per 15 min window).
RATE_LIMIT_MAX=200
# Strict per-IP limit for /auth/login and /auth/register (per 15 min window).
AUTH_RATE_LIMIT_MAX=10

# Shared secret expected in the `x-api-secret` header (gateway/front-door check).
# Leave unset in local dev; set a strong value in production.
API_SECRET=your_api_secret_key

# MongoDB. Local dev uses the single-node replica set from docker-compose:
#   directConnection=true is required to talk to a one-node replica set.
MONGO_URI=mongodb://localhost:27017/lag?replicaSet=rs0&directConnection=true
# Production (MongoDB Atlas) example:
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lag?retryWrites=true&w=majority
