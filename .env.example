PORT=3000
DB_TYPE=MONGO
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MongoDB - used when DB_TYPE=MONGO
MONGO_URI=mongodb://my_username:my_password@localhost:27017/my_database?authSource=admin
MONGO_USERNAME=my_username
MONGO_PASSWORD=my_password
MONGO_DATABASE=my_database

# Sequelize (MySQL) — used when DB_TYPE=SEQ
# SEQ_PORT=3306
# SEQ_HOST=localhost
# SEQ_DATABASE=my_database
# SEQ_USERNAME=my_username
# SEQ_PASSWORD=my_password
# MYSQL_ROOT_PASSWORD=your_mysql_root_password
