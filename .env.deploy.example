# Deployment settings for scripts/deploy-lambda.sh and scripts/setup-keepalive.sh.
# Copy to .env.deploy (gitignored) and fill in your values.

# Named profile — see docs/guides/deployment.md for the options:
# IAM access keys via `aws configure --profile <name>` (recommended),
# `aws login` (temporary console credentials), or Identity Center SSO.
# For login/SSO profiles the deploy scripts open the browser login
# automatically when the session is missing or expired.
AWS_PROFILE=lag-deploy
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=lag-money-manager

# REQUIRED — the PRODUCTION database. The deploy syncs indexes with it before
# uploading anything, and aborts if it is missing or the sync fails: production
# runs with autoIndex off, so this is the only thing that creates indexes there.
# Shipping without them leaves every unique constraint unenforced (duplicate
# emails, two default accounts) and the TTL collections growing forever.
#
# Rules for the URI:
#   - Include the database name before the "?" (/lag_money?...). Without it the
#     driver silently uses a database called "test".
#   - Keep replicaSet=... : balance updates run in multi-document transactions.
#   - Never add directConnection=true here — it is a local single-node hack and
#     would disable replica-set discovery against Atlas.
#   - URL-encode any special character in the password (@ : / ? # [ ] %).
# This value only affects the deploy scripts; local runs keep using .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lag_money?retryWrites=true&w=majority

# Optional keepalive overrides
# KEEPALIVE_RULE_NAME=lag-money-manager-keepalive
# KEEPALIVE_SCHEDULE=rate(1 day)
